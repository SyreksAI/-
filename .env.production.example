# === Скопируйте на VPS: cp .env.production.example .env ===
# Замените change-me значения и ключи API

# === Домен (для certbot — punycode, если IDN: xn--bl1apar.xn--80asehdb) ===
DOMAIN=дубльпар.online

# === База данных ===
POSTGRES_USER=dubpar
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=dubpar
DATABASE_URL=postgresql://dubpar:change-me-strong-db-password@database:5432/dubpar

# === Безопасность ===
SECRET_KEY=change-me-generate-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=60

# === Окружение ===
ENVIRONMENT=production
PUBLIC_SITE_URL=https://дубльпар.online
FRONTEND_URL=https://дубльпар.online

# === CORS (только ваш домен) ===
ALLOWED_ORIGINS=https://дубльпар.online,https://www.дубльпар.online

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === MinIO (медиа) ===
MEDIA_STORAGE=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change-me-minio-access-key
MINIO_SECRET_KEY=change-me-minio-secret-key-min-8-chars
MINIO_BUCKET=dubpar-media
MINIO_SECURE=false

# === Загрузка файлов ===
MAX_UPLOAD_VIDEO_SIZE=419430400

# === Email (SMTP) — Gmail App Password ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=syreksai@gmail.com
SMTP_PASSWORD=change-me-gmail-app-password
FROM_EMAIL=syreksai@gmail.com

# === Cloudflare Turnstile (обязательно для регистрации в prod) ===
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
VITE_TURNSTILE_SITE_KEY=

# === Frontend (задаются при npm run build на VPS) ===
VITE_SITE_URL=https://дубльпар.online
VITE_YANDEX_RTB_BLOCK_ID=

# === Юридическая информация ===
LEGAL_OPERATOR_NAME=SyrekAI
LEGAL_PLATFORM_NAME=дубльпар.online
LEGAL_SITE_URL=https://дубльпар.online
LEGAL_PRIVACY_EMAIL=syreksai@gmail.com
LEGAL_SUPPORT_EMAIL=syreksai@gmail.com
LEGAL_DOCS_VERSION=07.09.2026
VITE_LEGAL_OPERATOR_NAME=SyrekAI
VITE_LEGAL_PLATFORM_NAME=дубльпар.online
VITE_LEGAL_SITE_URL=https://дубльпар.online
VITE_LEGAL_PRIVACY_EMAIL=syreksai@gmail.com
VITE_LEGAL_SUPPORT_EMAIL=syreksai@gmail.com
VITE_LEGAL_DOCS_VERSION=07.09.2026

# === Логирование ===
LOG_LEVEL=INFO
