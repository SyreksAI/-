# === База данных ===
POSTGRES_USER=dubpar
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=dubpar
DATABASE_URL=postgresql://dubpar:change-me-strong-password@database:5432/dubpar

# === Безопасность ===
SECRET_KEY=change-me-generate-long-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
RESET_TOKEN_EXPIRE_MINUTES=60

# === Домен (для prod-деплоя на VPS) ===
DOMAIN=localhost

# === Окружение ===
ENVIRONMENT=development
PUBLIC_SITE_URL=http://localhost:8080

# === Медиа-хранилище (фото/видео/файлы) — не PostgreSQL ===
# local = папка uploads | minio = S3-объекты (метаданные в PostgreSQL)
MEDIA_STORAGE=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=dubpar-media
MINIO_SECURE=false

# === Загрузка файлов (байты) ===
MAX_UPLOAD_VIDEO_SIZE=419430400

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === CORS (через запятую) ===
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# === Email (SMTP) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=

# === Yandex OAuth (Yandex ID) ===
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
YANDEX_OAUTH_REDIRECT_URI=http://localhost:8080/api/auth/yandex/callback
# URL фронтенда после OAuth (для Docker/nginx — тот же порт, что PUBLIC_SITE_URL)
FRONTEND_URL=http://localhost:8080

# === Cloudflare Turnstile ===
# Секретный ключ (backend)
TURNSTILE_SECRET_KEY=
# Публичный ключ (backend + frontend; можно задать как TURNSTILE_SITE_KEY или VITE_TURNSTILE_SITE_KEY)
TURNSTILE_SITE_KEY=
VITE_TURNSTILE_SITE_KEY=
# Для локальной разработки без captcha:
# SKIP_TURNSTILE_VERIFY=true

# === Яндекс.Директ RTB (frontend) ===
VITE_YANDEX_RTB_BLOCK_ID=

# === Публичный URL сайта (frontend) ===
VITE_SITE_URL=http://localhost:8080

# === Юридическая информация (backend) ===
LEGAL_OPERATOR_NAME=SyrekAI
LEGAL_PLATFORM_NAME=дубльпар.online
LEGAL_SITE_URL=https://дубльпар.online
LEGAL_PRIVACY_EMAIL=syreksai@gmail.com
LEGAL_SUPPORT_EMAIL=syreksai@gmail.com
LEGAL_DOCS_VERSION=07.09.2026
LEGAL_INN=
LEGAL_OGRN=
LEGAL_ADDRESS=
LEGAL_PHONE=
LEGAL_ROSKOMNADZOR_NUMBER=

# === Юридическая информация (frontend, Vite — синхронизировать с LEGAL_*) ===
VITE_LEGAL_OPERATOR_NAME=SyrekAI
VITE_LEGAL_PLATFORM_NAME=дубльпар.online
VITE_LEGAL_SITE_URL=https://дубльпар.online
VITE_LEGAL_PRIVACY_EMAIL=syreksai@gmail.com
VITE_LEGAL_SUPPORT_EMAIL=syreksai@gmail.com
VITE_LEGAL_DOCS_VERSION=07.09.2026
VITE_LEGAL_INN=
VITE_LEGAL_OGRN=
VITE_LEGAL_ADDRESS=
VITE_LEGAL_PHONE=
VITE_LEGAL_ROSKOMNADZOR_NUMBER=

# === Smoke-тесты (не коммитить реальные пароли в git) ===
SMOKE_BASE_URL=http://localhost:8080
SMOKE_ADMIN_EMAIL=
SMOKE_ADMIN_PASSWORD=

# === Логирование ===
LOG_LEVEL=INFO
